<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Main App Theme (Material 2 for Android < 12) -->
    <style name="Theme.WPStatusSaver" parent="Theme.MaterialComponents.DayNight.NoActionBar.Bridge">
        <item name="colorPrimary">@color/whatsapp_primary</item>
        <item name="colorPrimaryDark">@color/whatsapp_primary_dark</item>
        <item name="colorSecondary">@color/whatsapp_accent</item>
        <item name="colorSecondaryVariant">@color/whatsapp_primary</item>
        <item name="colorAccent">@color/whatsapp_accent</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSecondaryContainer">#E8F5E9</item>
        <item name="colorOnSecondaryContainer">@color/whatsapp_primary</item>
        <item name="colorError">@color/delete_red</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/whatsapp_primary_dark</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="appBarBackground">@color/whatsapp_primary</item>
        <item name="appBarTitleColor">@color/white</item>
        <item name="appBarIconTint">@color/white</item>
        <item name="appBarSourceButtonBackground">#26FFFFFF</item>
        <item name="appBarSourceButtonTextColor">@color/white</item>
        <item name="selectionBarBackground">@color/whatsapp_primary_dark</item>
        <item name="bottomNavBackground">@color/surface_card</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/whatsapp_accent</item>
        <item name="switchStyle">@style/Widget.App.SwitchCompat</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.Medium</item>
    </style>

    <!-- Toolbar Theme Overlay for AppBar (Crisp White Icons in M2) -->
    <style name="ThemeOverlay.App.Toolbar" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="colorControlNormal">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">#CCFFFFFF</item>
        <item name="actionMenuTextColor">@color/white</item>
    </style>

    <!-- Switch Style with App Accent Color -->
    <style name="Widget.App.SwitchCompat" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="thumbTint">@color/switch_thumb_color</item>
        <item name="trackTint">@color/switch_track_color</item>
        <item name="colorControlActivated">@color/whatsapp_accent</item>
    </style>

    <!-- Translucent Media Viewer Theme with Live Background for Gestures -->
    <style name="Theme.WPStatusSaver.Fullscreen" parent="Theme.WPStatusSaver">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
    </style>

    <!-- Shapes -->
    <style name="ShapeAppearance.App.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">4dp</item>
    </style>

    <style name="ShapeAppearance.App.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">4dp</item>
    </style>

    <!-- Uppercase Tab Text Appearance -->
    <style name="TabTextAppearance.Material1" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="textAllCaps">true</item>
    </style>
</resources>